# Environment variable reference. Names and placeholders only; never put real secrets here.
# Copy the relevant parts to:
#   ./.env            -> read by docker compose (local MySQL container)
#   apps/api/.env     -> API, Prisma CLI and seed (development)
#   apps/api/.env.test-> API tests (database name MUST end in _test)
#   apps/web/.env     -> Next.js server (API_URL for the /api/v1 rewrite)

# --- docker compose (local MySQL only) ---
MYSQL_ROOT_PASSWORD=change-me-local-root-password
MYSQL_USER=task_app
MYSQL_PASSWORD=change-me-local-app-password

# --- API (apps/api) ---
NODE_ENV=development
PORT=4000
# mysql://USER:PASSWORD@HOST:PORT/DATABASE (local compose maps MySQL to host port 3307)
DATABASE_URL=mysql://task_app:change-me-local-app-password@localhost:3307/task_approval
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=8h
# Browser origin of the web app (CORS / CSRF allowlist). Comma-separate multiple origins.
FRONTEND_URL=http://localhost:3000

# --- Seed (optional overrides; defaults are the documented demo passwords) ---
SEED_ADMIN_PASSWORD=
SEED_EMPLOYEE1_PASSWORD=
SEED_EMPLOYEE2_PASSWORD=

# --- Web (apps/web, server-side only) ---
# Base URL of the Express API that Next.js proxies /api/v1/* to. Required in production.
API_URL=http://localhost:4000
